# Generated results and candidates stay local.
!outputs/
outputs/*
!outputs/README.md
models/training/*
!models/training/README.md
models/anonymization/assets.json

# The aligned KMU frames are the small runtime gallery used by the desktop
# examples; larger derived caches remain ignored.
!datasets/kmu-fed-aligned/
!datasets/kmu-fed-aligned/**

# The clean main branch carries only the current runtime weights.  The large
# visual GAN is stored with Git LFS; legacy, identity-diagnostic and training
# checkpoints remain local and are documented in models/README.md.
!models/anonymization/anonymizer_adversarial_v1.pt
!models/expression/expression_realtime_stable.pt
!models/expression/expression_machine_selector_texture.pt
!models/expression/expression_video_quality.ts.pt
!models/detection/face_detection_yunet_2023mar.onnx
!models/detection/face_landmarker.task
!models/anonymization/ganonymization_50.ckpt

# Keep only the small architecture adapter needed by the optional GAN runtime.
!third_party/ganonymization/
third_party/ganonymization/*
!third_party/ganonymization/LICENSE
!third_party/ganonymization/lib/
!third_party/ganonymization/lib/models/
!third_party/ganonymization/lib/models/pix2pix.py
